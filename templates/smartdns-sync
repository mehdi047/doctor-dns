def load_config():
    cfg = {}
    with open(CONFIG) as fh:
        for line in fh:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            cfg[k.strip()] = v.strip().strip('"').strip("'")
    for required in ("PANEL_HOST", "SYNC_SECRET", "SYNC_FINGERPRINT", "SELF_IP"):
        if not cfg.get(required):
            sys.exit("%s: %s is missing" % (CONFIG, required))
    return cfg


CFG = None

# Whether this panel is served over TLS. A relay with no domain has no
# certificate and serves plain http, and these pages are opened over an Iranian
